        <mxCell id="analytics" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" value="ANALYTICS / ML&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Recommendations • experiments • business metrics&lt;/font&gt;" vertex="1">
          <mxGeometry height="85" width="180" x="1294" y="790" as="geometry" />
