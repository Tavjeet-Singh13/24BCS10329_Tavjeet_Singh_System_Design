        </mxCell>
        <mxCell id="P-ZYLx6uAjCor6KKVaBe-30" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" value="Functional &amp; Non-Functional Requirements" vertex="1">
          <mxGeometry height="30" width="550" x="150" y="136" as="geometry" />
        </mxCell>
        <mxCell id="P-ZYLx6uAjCor6KKVaBe-31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" value="Functional Requirements (WHAT it does)" vertex="1">
          <mxGeometry height="40" width="400" x="-10" y="186" as="geometry" />
        </mxCell>
        <mxCell id="P-ZYLx6uAjCor6KKVaBe-32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" value="1. Shorten a URL&#xa;Given a long URL, generate a unique short code" vertex="1">
          <mxGeometry height="55" width="400" x="-10" y="246" as="geometry" />
        </mxCell>
        <mxCell id="P-ZYLx6uAjCor6KKVaBe-33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" value="2. Redirect&#xa;Visiting the short URL redirects user to the original long URL" vertex="1">
          <mxGeometry height="55" width="400" x="-10" y="316" as="geometry" />
        </mxCell>
        <mxCell id="P-ZYLx6uAjCor6KKVaBe-34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" value="3. Custom Alias (optional)&#xa;User can choose their own short code, e.g. short.ly/mybrand" vertex="1">
          <mxGeometry height="55" width="400" x="-10" y="386" as="geometry" />
        </mxCell>
        <mxCell id="P-ZYLx6uAjCor6KKVaBe-35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" value="4. Expiration (optional)&#xa;Links can expire automatically after a set date" vertex="1">
          <mxGeometry height="55" width="400" x="-10" y="456" as="geometry" />
        </mxCell>
        <mxCell id="P-ZYLx6uAjCor6KKVaBe-36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;" value="5. Analytics (optional)&#xa;Track number of clicks and basic stats per link" vertex="1">
          <mxGeometry height="55" width="400" x="-10" y="526" as="geometry" />
        </mxCell>
        <mxCell id="P-ZYLx6uAjCor6KKVaBe-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" value="Non-Functional Requirements (HOW WELL it does it)" vertex="1">
          <mxGeometry height="40" width="400" x="430" y="186" as="geometry" />
        </mxCell>
        <mxCell id="P-ZYLx6uAjCor6KKVaBe-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" value="1. High Availability&#xa;Service should almost never go down" vertex="1">
          <mxGeometry height="55" width="400" x="430" y="246" as="geometry" />
        </mxCell>
        <mxCell id="P-ZYLx6uAjCor6KKVaBe-39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" value="2. Low Latency&#xa;Redirection must happen in milliseconds" vertex="1">
          <mxGeometry height="55" width="400" x="430" y="316" as="geometry" />
        </mxCell>
        <mxCell id="P-ZYLx6uAjCor6KKVaBe-40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" value="3. Scalability&#xa;Must handle millions of URLs and billions of redirects" vertex="1">
          <mxGeometry height="55" width="400" x="430" y="386" as="geometry" />
        </mxCell>
        <mxCell id="P-ZYLx6uAjCor6KKVaBe-41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" value="4. Uniqueness&#xa;No two long URLs should ever get the same short code" vertex="1">
